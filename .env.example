# Basic Auth — protects the app from public access (all routes including /api)
BASIC_AUTH_USER=your_username
BASIC_AUTH_PASSWORD=your_password

# Required: OpenAI API key for chat, TTS, and Premium Voice
OPENAI_API_KEY=your_openai_api_key_here

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Model to use for chat. Defaults to gpt-4o-mini if not set.
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.
OPENAI_MODEL=gpt-4o-mini
